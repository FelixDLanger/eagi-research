{
  "name": "trva-navigator-site",
  "version": "0.8.1",
  "private": true,
  "description": "Static GitHub Pages build of the TRVA Navigator: deterministic engine and narrative, no model calls or keys.",
  "scripts": {
    "build": "esbuild main.jsx --bundle --minify --format=iife --target=es2018 --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --legal-comments=eof --outfile=../docs/assets/app.js"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
